rules_version = '2';

// One ruleset for the whole `temnorid-arena` Firebase project. temnorid.com and the
// temnorid-arena Unity game share it, so a deploy from either repo replaces the other's rules:
// keep every part here and in arena.temnorid.com/firestore.rules identical.
// Deploy: npm run rules
//
// Temnorid Arena (3d-unity-firebase layout):
//   users/{uid}                 a player's profile        (only that player)
//   users/{uid}/progress/{key}  a player's saved progress (only that player)
//   scenes/{sceneId}            Scene JSON: levels, scans (signed-in players read; the owner writes)
//   matches/{sessionId}         results and replays       (signed-in players read; clients never write)
//
// temnorid.com story writer. The document id is the slug, so `<kind>/<slug>` references match the
// JSON files in temnorid.com/src/data/:
//   stories/{slug}
//   stories/{slug}/chapters/{chapterSlug}   ordered by `order`; `tags` lists the lore entries in it
//   stories/{slug}/gaps/{gapSlug}           what the story leaves unexplained; `fills` on a story
//                                           lists the gaps of other stories it explains
//   admins/{uid}                            project owners; created by hand in the console only
//   reviews/{kind}__{slug}                  an owner's decision on a draft (only owners write)
// Released entries live in the code (temnorid.com/src/data/); Firestore holds drafts.
//   characters/{slug}, locations/{slug}, soldiers/{slug}, buildings/{slug}, and the workshop-only
//   factions, resources, items, recipes, spells, creatures, quests, events and cards: name,
//   summary, description, links, and a `fields` map with the kind's extra fields
// Every signed-in user reads every entry (the games read stories too); only the author writes.
// Writers sign in with Google (not anonymously) and add text only: no images, video or embeds.
//
// Temnorid: Lords (lords.temnorid.com). A player's own save is users/{uid}/progress/lords above.
//   lordsWorld/quadrants   how many villages each quarter of the world holds
//   lordsVillages/{uid}    each lord's village on the shared world map (every signed-in player reads)
// A village and its quarter's count are written together in one transaction.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isUser(uid);

      match /progress/{key} {
        allow read, write: if isUser(uid);
      }
    }

    match /scenes/{sceneId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Written by a trusted server with admin credentials, which rules do not apply to,
    // so a player cannot fake a result.
    match /matches/{sessionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- Story writer ----

    function isWriter() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function shortText(value, max) {
      return value is string && value.size() <= max;
    }

    function requiredText(value, max) {
      return shortText(value, max) && value.trim().size() > 0;
    }

    // Rich text from the editor. Tags that load assets, and CSS `url(...)`, are refused.
    function textOnlyHtml(html) {
      return shortText(html, 300000)
        && !html.matches('(?is).*(<(img|picture|source|video|audio|track|iframe|frame|object|embed|svg|canvas|link|script|style|form|input)[\\s/>]|url\\().*');
    }

    function references(list) {
      return list is list && list.size() <= 100;
    }

    function validSlug(slug) {
      return slug.size() <= 80 && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function validEntry(data, slug) {
      return data.slug == slug
        && validSlug(slug)
        && data.ownerUid == request.auth.uid
        && shortText(data.ownerName, 120)
        && data.updatedAt == request.time;
    }

    // Text is in whatever language the author writes; we translate when it moves into the code.
    function validStory(data, slug) {
      return data.keys().hasOnly(['slug', 'ownerUid', 'ownerName', 'title', 'summary', 'fills', 'createdAt', 'updatedAt'])
        && validEntry(data, slug)
        && requiredText(data.title, 160)
        && shortText(data.summary, 1000)
        && (!('fills' in data) || references(data.fills));
    }

    function validGap(data, slug) {
      return data.keys().hasOnly(['slug', 'title', 'details', 'chapterSlug', 'createdAt', 'updatedAt'])
        && data.slug == slug
        && validSlug(slug)
        && data.updatedAt == request.time
        && requiredText(data.title, 160)
        && shortText(data.details, 2000)
        && shortText(data.chapterSlug, 80);
    }

    function isAdmin() {
      return isWriter() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validReview(data) {
      return data.keys().hasOnly(['kind', 'slug', 'status', 'note', 'reviewerUid', 'updatedAt'])
        && data.status in ['new', 'considering', 'chosen', 'released', 'declined']
        && shortText(data.kind, 40)
        && shortText(data.slug, 80)
        && shortText(data.note, 1000)
        && data.reviewerUid == request.auth.uid
        && data.updatedAt == request.time;
    }

    function validChapter(data, slug) {
      return data.keys().hasOnly(['slug', 'order', 'title', 'html', 'tags', 'createdAt', 'updatedAt'])
        && data.slug == slug
        && validSlug(slug)
        && data.order is int && data.order >= 0 && data.order <= 1000
        && data.updatedAt == request.time
        && requiredText(data.title, 160)
        && textOnlyHtml(data.html)
        && (!('tags' in data) || references(data.tags));
    }

    function validLore(data, slug) {
      return data.keys().hasOnly(['slug', 'ownerUid', 'ownerName', 'name', 'role', 'summary', 'html', 'storySlugs', 'related', 'fields', 'createdAt', 'updatedAt'])
        && validEntry(data, slug)
        && requiredText(data.name, 120)
        && shortText(data.role, 160)
        && shortText(data.summary, 1000)
        && textOnlyHtml(data.html)
        && references(data.storySlugs)
        && references(data.related)
        && (!('fields' in data) || (data.fields is map && data.fields.size() <= 30));
    }

    function loreKind(kind) {
      return kind in ['characters', 'locations', 'soldiers', 'buildings', 'factions', 'resources',
        'items', 'recipes', 'spells', 'creatures', 'quests', 'events', 'cards'];
    }

    function canCreate() {
      return isWriter() && request.resource.data.createdAt == request.time;
    }

    function canUpdate() {
      return isWriter()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function canDelete() {
      return isWriter() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsStory(story) {
      return isWriter()
        && get(/databases/$(database)/documents/stories/$(story)).data.ownerUid == request.auth.uid;
    }

    match /stories/{slug} {
      allow read: if signedIn();
      allow create: if canCreate() && validStory(request.resource.data, slug);
      allow update: if canUpdate() && validStory(request.resource.data, slug);
      allow delete: if canDelete();

      // Chapters belong to the story's author. Delete them before the story.
      match /chapters/{chapter} {
        allow read: if signedIn();
        allow create: if ownsStory(slug)
          && request.resource.data.createdAt == request.time
          && validChapter(request.resource.data, chapter);
        allow update: if ownsStory(slug)
          && request.resource.data.createdAt == resource.data.createdAt
          && validChapter(request.resource.data, chapter);
        allow delete: if ownsStory(slug);
      }

      // Gaps belong to the story's author too. Delete them before the story.
      match /gaps/{gap} {
        allow read: if signedIn();
        allow create: if ownsStory(slug)
          && request.resource.data.createdAt == request.time
          && validGap(request.resource.data, gap);
        allow update: if ownsStory(slug)
          && request.resource.data.createdAt == resource.data.createdAt
          && validGap(request.resource.data, gap);
        allow delete: if ownsStory(slug);
      }
    }

    // The open-gaps page reads every story's gaps in one collection-group query.
    match /{path=**}/gaps/{gap} {
      allow read: if signedIn();
    }

    // A user may check whether they are an owner. Owners are added in the console only.
    match /admins/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // Everyone signed in sees the owners' decisions; only owners make them.
    match /reviews/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validReview(request.resource.data);
      allow delete: if isAdmin();
    }

    match /{kind}/{slug} {
      allow read: if loreKind(kind) && signedIn();
      allow create: if loreKind(kind)
        && canCreate() && validLore(request.resource.data, slug);
      allow update: if loreKind(kind)
        && canUpdate() && validLore(request.resource.data, slug);
      allow delete: if loreKind(kind) && canDelete();
    }

    // ---- Temnorid: Lords ----

    function lordsVillage(uid) {
      return /databases/$(database)/documents/lordsVillages/$(uid);
    }

    function lordsQuadrants() {
      return /databases/$(database)/documents/lordsWorld/quadrants;
    }

    // Exactly one quarter's count goes up by one: the quarter of the village being founded.
    function lordsCountBumped(quarter) {
      let before = resource == null ? {} : resource.data;
      return request.resource.data.diff(before).affectedKeys().hasOnly([quarter])
        && request.resource.data[quarter] == before.get(quarter, 0) + 1;
    }

    // Only while founding the caller's own village, in the same transaction.
    match /lordsWorld/quadrants {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && !exists(lordsVillage(request.auth.uid))
        && existsAfter(lordsVillage(request.auth.uid))
        && lordsCountBumped(getAfter(lordsVillage(request.auth.uid)).data.region);
    }

    // One village per lord, founded once and never moved. Its index must be the slot the
    // transaction just took in lordsWorld/quadrants. x and y are not checked against the index yet.
    match /lordsVillages/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['uid', 'lordName', 'element', 'region', 'index', 'x', 'y', 'createdAt'])
        && request.resource.data.uid == uid
        && requiredText(request.resource.data.lordName, 40)
        && request.resource.data.element in ['stone', 'fire']
        && request.resource.data.region in ['north-west', 'north-east', 'south-east', 'south-west']
        && request.resource.data.index is int && request.resource.data.index >= 0
        && request.resource.data.x is int && request.resource.data.y is int
        && request.resource.data.createdAt == request.time
        && getAfter(lordsQuadrants()).data[request.resource.data.region] == request.resource.data.index + 1;
      allow update, delete: if false;
    }
  }
}
