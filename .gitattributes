# Normalize line endings; Unity files are text unless listed as binary below.
* text=auto

# Unity YAML: merged with Unity's Smart Merge once it is configured, otherwise as plain text:
#   git config merge.unityyamlmerge.driver "'<Unity editor>/Data/Tools/UnityYAMLMerge' merge -p %O %B %A %A"
*.unity    text merge=unityyamlmerge diff
*.prefab   text merge=unityyamlmerge diff
*.asset    text merge=unityyamlmerge diff
*.mat      text merge=unityyamlmerge diff
*.anim     text merge=unityyamlmerge diff
*.controller text merge=unityyamlmerge diff
*.meta     text

# Binary assets. To keep the repo small, install Git LFS (git lfs install) and
# uncomment the lfs lines before committing the first large file.
*.png  binary
*.jpg  binary
*.psd  binary
*.fbx  binary
*.glb  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
